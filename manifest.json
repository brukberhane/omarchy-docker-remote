{
  "schemaVersion": 1,
  "id": "io.github.brukb.docker-remote",
  "name": "Docker Remote",
  "version": "0.1.0",
  "author": "brukb",
  "license": "MIT",
  "description": "Monitor and control Docker containers and Compose stacks on a remote host over SSH from the Omarchy bar.",
  "kinds": ["bar-widget"],
  "entryPoints": { "barWidget": "BarWidget.qml" },
  "barWidget": {
    "displayName": "Docker Remote",
    "description": "Remote Docker: compose stacks, health, start/stop/restart, logs, and shell",
    "category": "System",
    "allowMultiple": true,
    "defaultSection": "left",
    "defaults": {
      "host": "",
      "sshUser": "",
      "sshIdentityFile": "",
      "label": "",
      "portBaseUrl": "",
      "interval": 15,
      "showCount": true,
      "notifyUnhealthy": true,
      "terminal": "xdg-terminal-exec"
    },
    "schema": [
      { "key": "host", "type": "string", "label": "Remote host (IP, hostname, or SSH config alias)" },
      { "key": "sshUser", "type": "string", "label": "SSH user on the remote host" },
      { "key": "sshIdentityFile", "type": "string", "label": "SSH private key (blank = default agent/config)" },
      { "key": "label", "type": "string", "label": "Bar label (blank = host)" },
      { "key": "portBaseUrl", "type": "string", "label": "Base URL for port links (blank = http://<host>)" },
      { "key": "interval", "type": "integer", "label": "Refresh interval (seconds)", "min": 5, "max": 120, "step": 5, "defaultValue": 15 },
      { "key": "showCount", "type": "boolean", "label": "Show running/total count on the bar", "defaultValue": true },
      { "key": "notifyUnhealthy", "type": "boolean", "label": "Notify when a container turns unhealthy", "defaultValue": true },
      { "key": "terminal", "type": "string", "label": "Terminal launcher for logs/shell" }
    ]
  }
}
